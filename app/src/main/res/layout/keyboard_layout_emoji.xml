<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keys_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/KeyStyle"
            android:text="🎉" />

        <TextView
            style="@style/KeyStyle"
            android:text="💖" />

        <TextView
            style="@style/KeyStyle"
            android:text="✅" />

        <TextView
            style="@style/KeyStyle"
            android:text="💀" />

        <TextView
            style="@style/KeyStyle"
            android:text="😝" />

        <TextView
            style="@style/KeyStyle"
            android:text="🤔" />

        <TextView
            style="@style/KeyStyle"
            android:text="🐾" />

        <TextView
            style="@style/KeyStyle"
            android:text="🖤" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/KeyStyle"
            android:text="т-т" />

        <TextView
            style="@style/KeyStyle"
            android:text="тwт" />

        <TextView
            style="@style/KeyStyle"
            android:text="OwO" />

        <TextView
            style="@style/KeyStyle"
            android:text="\@_@" />

        <TextView
            style="@style/KeyStyle"
            android:text="&gt;_&lt;" />

        <TextView
            style="@style/KeyStyle"
            android:text="&gt;.&lt;" />

        <TextView
            style="@style/KeyStyle"
            android:text="^_^" />

        <TextView
            style="@style/KeyStyle"
            android:text="^^" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            style="@style/KeyStyle"
            android:text="UwU" />

        <TextView
            style="@style/KeyStyle"
            android:text="&gt;؎&lt;" />

        <TextView
            style="@style/KeyStyle"
            android:text="♡" />

        <TextView
            style="@style/KeyStyle"
            android:text="~" />

        <TextView
            style="@style/KeyStyle"
            android:text="&gt;w&lt;" />

        <TextView
            style="@style/KeyStyle"
            android:text="✧" />

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="@string/key_delete" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key_emoji_back"
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="abc" />

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="5"
            android:text=" " />

        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="@string/key_enter" />
    </LinearLayout>

</LinearLayout>