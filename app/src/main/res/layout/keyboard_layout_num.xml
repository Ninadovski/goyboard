<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keys_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/KeyStyle" android:text="1"/>
        <TextView style="@style/KeyStyle" android:text="2"/>
        <TextView style="@style/KeyStyle" android:text="3"/>
        <TextView style="@style/KeyStyle" android:text="4"/>
        <TextView style="@style/KeyStyle" android:text="5"/>
        <TextView style="@style/KeyStyle" android:text="6"/>
        <TextView style="@style/KeyStyle" android:text="7"/>
        <TextView style="@style/KeyStyle" android:text="8"/>
        <TextView style="@style/KeyStyle" android:text="9"/>
        <TextView style="@style/KeyStyle" android:text="0"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/KeyStyle" android:text="+"/>
        <TextView style="@style/KeyStyle" android:text="-"/>
        <TextView style="@style/KeyStyle" android:text="*"/>
        <TextView style="@style/KeyStyle" android:text="/"/>
        <TextView style="@style/KeyStyle" android:text="="/>
        <TextView style="@style/KeyStyle" android:text="%"/>
        <TextView style="@style/KeyStyle" android:text="&lt;"/>
        <TextView style="@style/KeyStyle" android:text="&gt;"/>
        <TextView style="@style/KeyStyle" android:text="["/>
        <TextView style="@style/KeyStyle" android:text="]"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView style="@style/KeyStyle" android:text=","/>
        <TextView style="@style/KeyStyle" android:text="\\"/>
        <TextView style="@style/KeyStyle" android:text="|"/>
        <TextView style="@style/KeyStyle" android:text="&amp;"/>
        <TextView style="@style/KeyStyle" android:text="#"/>
        <TextView style="@style/KeyStyle" android:text="&#64;"/>
        <TextView style="@style/KeyStyle" android:text="$"/>
        <TextView style="@style/KeyStyle" android:text="{"/>
        <TextView style="@style/KeyStyle" android:text="}"/>
        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="@string/key_delete"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/key_num_back"
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="abc"/>
        <TextView
            style="@style/KeyStyle"
            android:layout_weight="6"
            android:text=" "/>
        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.2"
            android:text="."/>
        <TextView
            style="@style/KeyStyle"
            android:layout_weight="1.5"
            android:text="@string/key_enter"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"/>
</LinearLayout>